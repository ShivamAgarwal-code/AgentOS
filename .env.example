# ANTHROPIC_API_KEY: Required for Claude (Anthropic) API calls.
# The AgentOS agent planner and the decision-replay engine both use Claude.
# Without it, AgentOS falls back to a built-in heuristic planner so the demo still runs.
ANTHROPIC_API_KEY="sk-ant-..."

# ANTHROPIC_MODEL: Optional model override. Defaults to claude-opus-4-8.
ANTHROPIC_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────────────────────
# LIVE APP INTEGRATIONS (all optional)
# Set any of these to make the agent take REAL actions in that app.
# Any app left unconfigured runs in realistic simulation instead.
# ─────────────────────────────────────────────────────────────

# Slack — Bot User OAuth Token (xoxb-...) enables live chat.postMessage
SLACK_BOT_TOKEN="xoxb-your-bot-token"
SLACK_SIGNING_SECRET="your-signing-secret"

# Discord — incoming webhook URL enables live channel messages
DISCORD_WEBHOOK_URL=""

# GitHub — personal access token enables live issue/comment creation
GITHUB_TOKEN=""
# Optional default repo when the goal doesn't specify one, e.g. "owner/repo"
GITHUB_DEFAULT_REPO=""

# Notion — internal integration token + a parent page id enable live pages
NOTION_TOKEN=""
NOTION_PARENT_PAGE_ID=""

# Linear — personal API key enables live issue creation (team auto-detected)
LINEAR_API_KEY=""

# Trello — API key + token + a target list id enable live card creation
TRELLO_KEY=""
TRELLO_TOKEN=""
TRELLO_LIST_ID=""

