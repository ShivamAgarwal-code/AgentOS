# ANTHROPIC_API_KEY: Required for Claude (Anthropic) API calls.
# The AgentOS agent planner and the decision-replay engine both use Claude.
# Without it, AgentOS falls back to a built-in heuristic planner so the demo still runs.
ANTHROPIC_API_KEY="sk-ant-..."

# ANTHROPIC_MODEL: Optional model override. Defaults to claude-opus-4-8.
ANTHROPIC_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SLACK CONFIGURATION
# Slack Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN="xoxb-your-bot-token"
# Slack App Signing Secret (from Slack App settings page)
SLACK_SIGNING_SECRET="your-signing-secret"
# Local port to bind Slack listen operations
SLACK_PORT=3001

# DATABASE CONFIGURATION
# SQLite file name pathway
SQLITE_DB_FILE="chronicle_memory.db"

